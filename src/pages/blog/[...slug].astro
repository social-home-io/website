---
import PostPage from "../../components/pages/PostPage.astro";
import { getLocalizedEntries, isPost, type LocalizedEntry } from "../../i18n/content";

/**
 * Every English entry under ``src/content/en/blog/`` renders here.
 * The slug keeps the ``blog/`` prefix in the collection, so strip
 * it for the route param. Other locales: ``[lang]/blog/[...slug]``.
 */
export async function getStaticPaths() {
  const posts = await getLocalizedEntries("en", isPost);
  return posts.map((post) => ({
    params: { slug: post.entry.slug.replace(/^blog\//, "") },
    props: { post },
  }));
}

interface Props {
  post: LocalizedEntry;
}
const { post } = Astro.props;
---

<PostPage post={post} />
