---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

/**
 * ``/blog/`` — feature stories, newest first. Posts live in
 * ``src/content/en/blog/`` alongside the docs so the CI
 * translator picks them up too.
 */

const posts = (
  await getCollection("en", ({ slug, data }) => slug.startsWith("blog/") && data.draft !== true)
).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const formatDate = (d: Date) =>
  d.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base
  title="Blog"
  description="New features in Social Home, told from the household's side — what changes in your day, with screenshots."
  active="/blog/"
>
  <section class="band band--tight">
    <div class="shell">
      <p class="eyebrow">Blog</p>
      <h1 class="blog__h1">What's new <em>at home</em>.</h1>
      <p class="blog__lede">
        New features, told from your household's side: what changes in your day, with screenshots.
        Every release is listed on
        <a href="https://github.com/social-home-io/socialhome/releases">GitHub Releases</a>.
      </p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <ul class="blog__list">
        {
          posts.map((post) => (
            <li>
              <a class="card" href={`/${post.slug}/`}>
                {post.data.image && (
                  <img
                    class="card__img"
                    src={post.data.image}
                    alt={post.data.imageAlt ?? ""}
                    loading="lazy"
                  />
                )}
                <div class="card__text">
                  {post.data.date && (
                    <time class="card__date" datetime={post.data.date.toISOString().slice(0, 10)}>
                      {formatDate(post.data.date)}
                    </time>
                  )}
                  <h2>{post.data.title}</h2>
                  {post.data.description && <p>{post.data.description}</p>}
                  <span class="card__more">Read the post →</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .blog__h1 {
    margin: var(--s-4) 0 var(--s-4);
  }
  .blog__h1 em {
    color: var(--hearth);
  }
  .blog__lede {
    color: var(--ink-soft);
    font: 380 var(--step-1) / 1.5 var(--font-body);
  }

  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }
  .blog__list li {
    max-width: none;
    margin: 0;
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }
  .card__img {
    display: block;
    width: 100%;
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-3);
    box-shadow: var(--lift-card);
    transition: transform var(--dur-settle) var(--ease-quill);
  }
  .card:hover .card__img {
    transform: translateY(-3px);
  }
  .card__date {
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }
  .card h2 {
    margin: var(--s-3) 0 var(--s-3);
    font-size: var(--step-3);
    text-wrap: balance;
  }
  .card p {
    color: var(--ink-soft);
  }
  .card__more {
    font: 600 var(--step-0) / 1 var(--font-body);
    color: var(--hearth);
  }
  .card:hover h2 {
    color: var(--hearth-deep);
  }

  @media (max-width: 880px) {
    .card {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__img {
      transition: none;
    }
    .card:hover .card__img {
      transform: none;
    }
  }
</style>
