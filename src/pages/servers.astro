---
import Base from "../layouts/Base.astro";
import QrCard from "../components/QrCard.astro";

/**
 * ``/servers/`` lives at the site root (per spec §9.2l), not
 * under ``/docs/`` — it's a "connect to the relay we run for
 * you, in one tap" page. The Social Home project runs **one**
 * public Global Federation Server at ``gfs.social-home.io``;
 * operators who want different policy boundaries can still
 * BYOG (see ``/docs/running-a-gfs/``).
 */

const gfs = "https://gfs.social-home.io";
---

<Base
  title="Our server"
  description="The Social Home project runs one public Global Federation Server, live at gfs.social-home.io. Content-blind by design: it carries sealed posts and never reads them. Connect in one tap, or run your own."
  active="/servers/"
>
  <section class="band band--tight">
    <div class="shell">
      <p class="eyebrow">Global Federation Server</p>
      <h1 class="servers__h1">
        Connect to the relay we run <em>for you</em>.
      </h1>
      <p class="servers__lede">
        The Social Home project runs one public Global Federation Server (GFS) — live now at
        <code>gfs.social-home.io</code>. It helps your public and global spaces and your public
        Moments reach households that haven't paired with you yet. Every post is sealed before it
        leaves your Home Assistant, so the relay carries it without ever reading it.
      </p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell servers__grid">
      <article class="server">
        <header>
          <span class="server__sigil" aria-hidden="true">⬡</span>
          <div>
            <span class="server__kind">Hosted by Social Home</span>
            <h2>Global Federation Server</h2>
            <p class="server__host">
              <span class="server__live"
                ><span class="server__pulse" aria-hidden="true"></span>Live</span
              >
              <code>gfs.social-home.io</code>
            </p>
          </div>
        </header>
        <p>
          One QR scan and you're connected. Public spaces show up on the map; public Moments fan out
          to followers across every paired household; Highlights public links route through here
          too. Content-blind by design.
        </p>
        <ul class="server__bullets">
          <li>Public spaces map + global spaces</li>
          <li>Public Momentum directory + follow graph</li>
          <li>Highlights public-link relay</li>
          <li>Age-gate policy enforced</li>
          <li>Sealed posts queued for offline households, then gone</li>
          <li>Never reads message, photo, or call content</li>
        </ul>
        <ul class="server__chips" aria-label="Technical terms">
          <li>padded 1/4/16/64/128 KiB</li>
          <li>24 h queue</li>
          <li>zero content stored</li>
        </ul>
        <footer>
          <a class="btn btn--hearth" href={`sh://gfs-pair/${gfs}`}> Connect → </a>
          <QrCard gfsUrl={gfs} label="Social Home GFS pairing QR code" />
        </footer>
      </article>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <h2>How to connect</h2>
      <ol class="howto">
        <li>Open <strong>Social Home</strong> on your Home Assistant.</li>
        <li>Go to <strong>Settings → Connections → Global Federation Servers</strong>.</li>
        <li>Tap <strong>Add GFS</strong>.</li>
        <li>Scan the QR code above — or paste the URL.</li>
      </ol>
      <p>
        Most households only need one. You can pair with additional relays for resilience or
        private-community policy.
      </p>

      <h2>What this relay can and can't see</h2>
      <p>
        The relay only ever handles sealed envelopes. What it learns depends on the kind of space
        the envelope belongs to — and in every case the answer to "the content?" is never.
      </p>
      <table class="sees">
        <thead>
          <tr>
            <th scope="col">Space</th>
            <th scope="col">The relay sees</th>
            <th scope="col">Never</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">
              Public &amp; global spaces
              <span class="sees__mode">trusted · default</span>
            </th>
            <td>Which household posted, into which space, when.</td>
            <td>The content.</td>
          </tr>
          <tr>
            <th scope="row">
              Public &amp; global spaces
              <span class="sees__mode">strict · owner's choice</span>
            </th>
            <td>The same — but not who posted.</td>
            <td>The content, or the sender.</td>
          </tr>
          <tr>
            <th scope="row">
              Private space with the GFS switched on
              <span class="sees__mode">off by default</span>
            </th>
            <td>Which households take part.</td>
            <td>The space's name, its posts, or its key.</td>
          </tr>
        </tbody>
      </table>
      <ul class="server__chips server__chips--loose" aria-label="Technical terms">
        <li>routing metadata only</li>
        <li>identity-free host relay</li>
        <li>anonymous_publish proof</li>
        <li>strict mode · shared writer key</li>
      </ul>
      <p>
        Like any server on the internet it also sees your IP address, the time of each request and
        the size bucket of each envelope. Those residuals are written down in the
        <a href="/docs/security/">security model</a>.
      </p>

      <h2>Run your own</h2>
      <p>
        For a private community, organisation, or household-specific relay, you can stand up your
        own GFS on any VPS in about 15 minutes.
        <a href="/docs/running-a-gfs/">Set up your own GFS →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .servers__h1 {
    font-size: var(--step-4);
    margin: var(--s-3) 0 var(--s-4);
    max-width: 18ch;
  }
  .servers__h1 em {
    color: var(--hearth);
  }
  .servers__lede {
    font: 380 var(--step-1) / 1.5 var(--font-body);
    color: var(--ink-soft);
    max-width: var(--measure-prose);
    margin: 0;
  }

  .servers__grid {
    display: grid;
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
    gap: var(--s-6);
  }

  .server {
    position: relative;
    background: var(--paper-deep);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-3);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .server::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    border-radius: var(--r-3) 0 0 var(--r-3);
    background: var(--moss);
  }

  .server header {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--s-3);
    align-items: center;
  }
  .server__sigil {
    width: 48px;
    height: 48px;
    line-height: 48px;
    text-align: center;
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-2);
    color: var(--moss);
    font-size: 22px;
  }
  .server__kind {
    display: inline-block;
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: var(--r-pill);
    background: var(--moss-tint);
    color: var(--moss);
    margin-bottom: 6px;
  }
  .server h2 {
    font-size: var(--step-2);
    margin: 0;
  }
  .server__host {
    margin: 4px 0 0;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    font: 500 var(--step-0) / 1 var(--font-mono);
    color: var(--ink-soft);
  }
  .server__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px 3px 8px;
    border-radius: var(--r-pill);
    background: var(--moss-tint);
    color: var(--moss);
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .server__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 0 0 var(--tape-moss);
    animation: serverPulse 2.4s var(--ease-quill) infinite;
  }
  @keyframes serverPulse {
    0% {
      box-shadow: 0 0 0 0 var(--tape-moss);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .server__pulse {
      animation: none;
    }
  }
  .server__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .server__bullets li {
    margin: 0;
    padding-left: 22px;
    position: relative;
    color: var(--ink-soft);
    font-size: var(--step-0);
  }
  .server__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--moss);
    font-weight: 600;
  }
  .server__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .server__chips li {
    margin: 0;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: var(--moss-tint);
    color: var(--moss);
    font: 500 calc(var(--step--1) - 1px) / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
  }
  .server__chips--loose {
    margin: var(--s-3) 0 var(--s-4);
  }
  .server footer {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px dashed var(--rule-soft);
  }

  .howto {
    counter-reset: howto;
    list-style: none;
    margin: var(--s-3) 0 var(--s-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .howto li {
    counter-increment: howto;
    padding-left: 36px;
    position: relative;
    color: var(--ink);
  }
  .howto li::before {
    content: counter(howto);
    position: absolute;
    left: 0;
    top: 1px;
    width: 24px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    border-radius: 50%;
    background: var(--hearth);
    color: var(--paper);
    font: 600 calc(var(--step--1)) / 1 var(--font-mono);
  }
  /* "What this relay can and can't see" — same recipe as the server card:
     paper-deep surface, soft rules, moss accents, mono for the mode label. */
  .sees {
    width: 100%;
    max-width: var(--measure-prose);
    border-collapse: separate;
    border-spacing: 0;
    margin: var(--s-4) 0 var(--s-3);
    background: var(--paper-deep);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-2);
    overflow: hidden;
    font: 500 var(--step-0) / 1.45 var(--font-body);
  }
  .sees th,
  .sees td {
    padding: var(--s-3) var(--s-4);
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--rule-soft);
  }
  .sees thead th {
    border-top: none;
    background: var(--moss-tint);
    color: var(--moss);
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sees tbody th {
    font-weight: 600;
    color: var(--ink);
    width: 34%;
  }
  .sees td {
    color: var(--ink-soft);
  }
  .sees td:last-child {
    color: var(--moss);
    font-weight: 600;
  }
  .sees__mode {
    display: block;
    margin-top: var(--s-1);
    font: 500 calc(var(--step--1) - 1px) / 1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink-quiet);
  }
  @media (max-width: 540px) {
    .sees,
    .sees thead,
    .sees tbody,
    .sees tr,
    .sees th,
    .sees td {
      display: block;
    }
    .sees thead {
      display: none;
    }
    .sees tbody th {
      width: auto;
    }
    .sees td {
      border-top: none;
      padding-top: 0;
    }
    .sees td::before {
      content: "Sees · ";
      font: 500 calc(var(--step--1) - 1px) / 1.3 var(--font-mono);
      letter-spacing: 0.04em;
      color: var(--ink-quiet);
    }
    .sees td:last-child::before {
      content: "Never · ";
    }
  }
</style>
