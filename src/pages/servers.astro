---
import Base from "../layouts/Base.astro";
import QrCard from "../components/QrCard.astro";

/**
 * ``/servers/`` lives at the site root (per spec §9.2l), not
 * under ``/docs/`` — it's a "connect to the relay we run for
 * you, in one tap" page. The Social Home project runs **one**
 * public Global Federation Server at ``gfs.social-home.io``;
 * operators who want different policy boundaries can still
 * BYOG (see ``/docs/running-a-gfs/``).
 */

const gfs = "https://gfs.social-home.io";
---

<Base
  title="The Social Home relay"
  description="The Social Home project runs one public Global Federation Server at gfs.social-home.io — hosted in the EU on Hetzner Frankfurt. Connect in one tap, or run your own."
>
  <section class="band band--tight">
    <div class="shell">
      <p class="eyebrow">Global Federation Server</p>
      <h1 class="servers__h1">
        Connect to the relay we run <em>for you</em>.
      </h1>
      <p class="servers__lede">
        The Social Home project runs one public Global Federation Server, hosted in the EU on
        Hetzner Frankfurt. It helps your Spaces and public Moments reach households that haven't
        paired with you yet — the relay never reads any messages, photos, or content.
      </p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell servers__grid">
      <article class="server">
        <header>
          <span class="server__sigil" aria-hidden="true">⬡</span>
          <div>
            <span class="server__kind">Hosted by Social Home</span>
            <h2>Global Federation Server</h2>
            <p class="server__host"><code>gfs.social-home.io</code></p>
          </div>
        </header>
        <p>
          One QR scan and you're paired. Spaces show up in the public directory; public Moments fan
          out to followers across every paired household; Highlights public links route through here
          too. EU-hosted, content-blind by design.
        </p>
        <ul class="server__bullets">
          <li>Public Spaces directory (moderated)</li>
          <li>Public Momentum directory + follow graph</li>
          <li>Highlights public-link relay</li>
          <li>Age-gate policy enforced</li>
          <li>Hosted in the EU on Hetzner Frankfurt</li>
          <li>Never reads message, photo, or call content</li>
        </ul>
        <footer>
          <a class="btn btn--hearth" href={`sh://gfs-pair/${gfs}`}> Connect → </a>
          <QrCard gfsUrl={gfs} label="Social Home GFS pairing QR code" />
        </footer>
      </article>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <h2>How to connect</h2>
      <ol class="howto">
        <li>Open <strong>Social Home</strong> on your Home Assistant.</li>
        <li>Go to <strong>Settings → Connections → Global Servers</strong>.</li>
        <li>Tap <strong>+ Connect GFS</strong>.</li>
        <li>Scan the QR code above — or paste the URL.</li>
      </ol>
      <p>
        Most households only need one. You can pair with additional relays for resilience or
        private-community policy.
      </p>

      <h2>Run your own</h2>
      <p>
        For a private community, organisation, or household-specific relay, you can stand up your
        own GFS on any VPS in about 15 minutes.
        <a href="/docs/running-a-gfs/">Set up your own GFS →</a>
      </p>

      <h2>Status</h2>
      <p>
        Server status, uptime, and incident history live at
        <a href="https://status.social-home.io" rel="external">status.social-home.io</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .servers__h1 {
    font-size: var(--step-4);
    margin: var(--s-3) 0 var(--s-4);
    max-width: 18ch;
  }
  .servers__h1 em {
    color: var(--hearth);
  }
  .servers__lede {
    font: 380 var(--step-1) / 1.5 var(--font-body);
    color: var(--ink-soft);
    max-width: var(--measure-prose);
    margin: 0;
  }

  .servers__grid {
    display: grid;
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
    gap: var(--s-6);
  }

  .server {
    position: relative;
    background: var(--paper-deep);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-3);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .server::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    border-radius: var(--r-3) 0 0 var(--r-3);
    background: var(--moss);
  }

  .server header {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--s-3);
    align-items: center;
  }
  .server__sigil {
    width: 48px;
    height: 48px;
    line-height: 48px;
    text-align: center;
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-2);
    color: var(--moss);
    font-size: 22px;
  }
  .server__kind {
    display: inline-block;
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: var(--r-pill);
    background: var(--moss-tint);
    color: var(--moss);
    margin-bottom: 6px;
  }
  .server h2 {
    font-size: var(--step-2);
    margin: 0;
  }
  .server__host {
    margin: 4px 0 0;
    font: 500 var(--step-0) / 1 var(--font-mono);
    color: var(--ink-soft);
  }
  .server__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .server__bullets li {
    margin: 0;
    padding-left: 22px;
    position: relative;
    color: var(--ink-soft);
    font-size: var(--step-0);
  }
  .server__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--moss);
    font-weight: 600;
  }
  .server footer {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px dashed var(--rule-soft);
  }

  .howto {
    counter-reset: howto;
    list-style: none;
    margin: var(--s-3) 0 var(--s-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .howto li {
    counter-increment: howto;
    padding-left: 36px;
    position: relative;
    color: var(--ink);
  }
  .howto li::before {
    content: counter(howto);
    position: absolute;
    left: 0;
    top: 1px;
    width: 24px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    border-radius: 50%;
    background: var(--hearth);
    color: var(--paper);
    font: 600 calc(var(--step--1)) / 1 var(--font-mono);
  }
</style>
