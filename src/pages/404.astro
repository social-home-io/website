---
import Base from "../layouts/Base.astro";
---

<Base title="404 — page not found">
  <section class="band">
    <div class="shell oops">
      <p class="eyebrow">Error · 404</p>
      <h1>🏠 This page moved to another household.</h1>
      <p class="oops__lede">The page you asked for either moved or never existed.</p>
      <p class="oops__ctas">
        <a class="btn btn--hearth" href="/">Go home</a>
        <a class="btn btn--ghost" href="/docs/">Search the docs</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .oops {
    max-width: 56ch;
    padding-block: clamp(56px, 9vw, 120px);
  }
  .oops h1 {
    margin: var(--s-3) 0 var(--s-4);
    font-size: var(--step-4);
  }
  .oops__lede {
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
    font: 380 var(--step-1) / 1.5 var(--font-body);
  }
  .oops__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
</style>
