---
import Base from "../layouts/Base.astro";
---

<Base title="404 — page not found">
  <section class="band">
    <div class="shell oops">
      <p class="eyebrow">Status: 404 · Reading: a page that isn't here yet</p>
      <h1>Nothing on the wall under that pin.</h1>
      <p class="oops__lede">
        The page you asked for either moved, didn't survive a translation run, or never existed. Try
        the docs index — that's where the actually-pinned posts live.
      </p>
      <p class="oops__ctas">
        <a class="btn btn--hearth" href="/">Back to the home page</a>
        <a class="btn btn--ghost" href="/docs/">Read the docs</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .oops {
    max-width: 56ch;
    padding-block: clamp(56px, 9vw, 120px);
  }
  .oops h1 {
    margin: var(--s-3) 0 var(--s-4);
    font-size: var(--step-4);
  }
  .oops__lede {
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
    font: 380 var(--step-1) / 1.5 var(--font-body);
  }
  .oops__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
</style>
