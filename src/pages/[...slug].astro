---
import { getCollection, type CollectionEntry } from "astro:content";
import Docs from "../layouts/Docs.astro";

/**
 * One file routes every English markdown content entry that
 * isn't the landing page. Astro's static-build picks up the
 * collection at build time and renders ``Content`` against the
 * ``Docs`` layout.
 */

export async function getStaticPaths() {
  const all = await getCollection("en");
  return all.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"en">;
}
const { entry } = Astro.props;
const { Content } = await entry.render();

// Highlight the "Docs" header link on every doc subpage; for the
// flat top-level pages (changelog, contribute, license) leave
// the active prop unset so nothing is highlighted.
const activeRoot = entry.slug.startsWith("docs") ? "/docs/" : undefined;
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  active={activeRoot}
  slug={entry.slug}
>
  <Content />
</Docs>
