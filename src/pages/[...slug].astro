---
import DocPage from "../components/pages/DocPage.astro";
import { getLocalizedEntries, isPage, type LocalizedEntry } from "../i18n/content";

/**
 * One file routes every English markdown content entry that
 * isn't the landing page or a blog post. The other locales are
 * served by ``[lang]/[...slug].astro``.
 */
export async function getStaticPaths() {
  const pages = await getLocalizedEntries("en", isPage);
  return pages.map((page) => ({ params: { slug: page.entry.slug }, props: { page } }));
}

interface Props {
  page: LocalizedEntry;
}
const { page } = Astro.props;
---

<DocPage page={page} />
