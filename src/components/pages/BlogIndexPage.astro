---
/**
 * ``/blog/`` — feature stories, newest first. Shared by the English
 * route and ``/<lang>/blog/``; the route hands in the localized
 * posts (English fills any gap).
 */
import Base from "../../layouts/Base.astro";
import { formatDate, getLocale, localePath, localizeHtml, t } from "../../i18n";
import type { LocalizedEntry } from "../../i18n/content";

interface Props {
  posts: LocalizedEntry[];
}
const { posts } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const s = t(locale);
const sorted = [...posts].sort(
  (a, b) => (b.entry.data.date?.getTime() ?? 0) - (a.entry.data.date?.getTime() ?? 0),
);
---

<Base title={s.blog.title} description={s.blog.description} active="/blog/">
  <section class="band band--tight">
    <div class="shell">
      <p class="eyebrow">{s.blog.eyebrow}</p>
      <h1 class="blog__h1" set:html={s.blog.h1Html} />
      <p class="blog__lede" set:html={localizeHtml(locale, s.blog.ledeHtml)} />
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <ul class="blog__list">
        {
          sorted.map(({ entry: post }) => (
            <li>
              <a class="card" href={localePath(locale, `/${post.slug}/`)}>
                {post.data.image && (
                  <img
                    class="card__img"
                    src={post.data.image}
                    alt={post.data.imageAlt ?? ""}
                    loading="lazy"
                  />
                )}
                <div class="card__text">
                  {post.data.date && (
                    <time class="card__date" datetime={post.data.date.toISOString().slice(0, 10)}>
                      {formatDate(locale, post.data.date)}
                    </time>
                  )}
                  <h2>{post.data.title}</h2>
                  {post.data.description && <p>{post.data.description}</p>}
                  <span class="card__more">{s.blog.readPost}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .blog__h1 {
    margin: var(--s-4) 0 var(--s-4);
  }
  .blog__h1 em {
    color: var(--hearth);
  }
  .blog__lede {
    color: var(--ink-soft);
    font: 380 var(--step-1) / 1.5 var(--font-body);
  }

  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }
  .blog__list li {
    max-width: none;
    margin: 0;
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }
  .card__img {
    display: block;
    width: 100%;
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-3);
    box-shadow: var(--lift-card);
    transition: transform var(--dur-settle) var(--ease-quill);
  }
  .card:hover .card__img {
    transform: translateY(-3px);
  }
  .card__date {
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }
  .card h2 {
    margin: var(--s-3) 0 var(--s-3);
    font-size: var(--step-3);
    text-wrap: balance;
  }
  .card p {
    color: var(--ink-soft);
  }
  .card__more {
    font: 600 var(--step-0) / 1 var(--font-body);
    color: var(--hearth);
  }
  .card:hover h2 {
    color: var(--hearth-deep);
  }

  @media (max-width: 880px) {
    .card {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__img {
      transition: none;
    }
    .card:hover .card__img {
      transform: none;
    }
  }
</style>
