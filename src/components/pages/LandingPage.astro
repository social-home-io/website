---
/**
 * The landing page, shared by ``/`` (en) and ``/<lang>/``. Every
 * string comes from ``src/i18n/<locale>.ts``; the components read
 * the locale from ``Astro.currentLocale`` themselves.
 */
import Base from "../../layouts/Base.astro";
import HeroSection from "../HeroSection.astro";
import ValuePropStrip from "../ValuePropStrip.astro";
import FeatureGrid from "../FeatureGrid.astro";
import AppsFeature from "../AppsFeature.astro";
import SpaceWall from "../SpaceWall.astro";
import TrustBand from "../TrustBand.astro";
import InstallBanner from "../InstallBanner.astro";
import { getLocale, localizeHtml, t } from "../../i18n";
import { installHref } from "../../i18n/en";

const locale = getLocale(Astro.currentLocale);
const s = t(locale);
const fed = s.landing.federated;
---

<Base title={s.site.name} description={s.site.landingDescription} active="/">
  <HeroSection />
  <ValuePropStrip />
  <FeatureGrid />
  <AppsFeature />

  <section class="federated band">
    <div class="shell federated__inner">
      <div class="federated__copy">
        <span class="eyebrow">
          <span class="dot dot--moss" aria-hidden="true"></span>
          {fed.eyebrow}
        </span>
        <h2>{fed.heading}</h2>
        <p set:html={localizeHtml(locale, fed.p1Html)} />
        <p set:html={localizeHtml(locale, fed.p2Html)} />
      </div>
      <div class="federated__wall">
        <SpaceWall />
      </div>
    </div>
  </section>

  <TrustBand />

  <InstallBanner installHref={installHref} />
</Base>
<style>
  .federated__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  @media (max-width: 980px) {
    .federated__inner {
      grid-template-columns: 1fr;
    }
  }
  .federated__copy h2 {
    margin: var(--s-3) 0 var(--s-4);
  }
  .federated__copy p {
    color: var(--ink-soft);
    max-width: var(--measure-narrow);
  }
  .dot--moss {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 0 4px var(--moss-tint);
  }
</style>
