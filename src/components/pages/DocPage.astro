---
/**
 * Renders one non-blog content entry against the ``Docs`` layout.
 * Shared by ``/[...slug]`` (en) and ``/[lang]/[...slug]``.
 */
import Docs from "../../layouts/Docs.astro";
import type { LocalizedEntry } from "../../i18n/content";

interface Props {
  page: LocalizedEntry;
}
const { page } = Astro.props;
const { entry, fallback } = page;
const { Content } = await entry.render();

// Highlight the "Docs" header link on every doc subpage; for the
// flat top-level pages (contribute, license) leave the active
// prop unset so nothing is highlighted.
const activeRoot = entry.slug.startsWith("docs") ? "/docs/" : undefined;
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  active={activeRoot}
  slug={entry.slug}
  fallback={fallback}
>
  <Content />
</Docs>
