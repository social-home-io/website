---
import LogoMark from "./LogoMark.astro";
import FamilyWall from "./FamilyWall.astro";
import type { HeroCopy } from "../types";

interface Props {
  copy: HeroCopy;
}
const { copy } = Astro.props;
---

<section class="hero">
  <div class="shell hero__type">
    <p class="hero__eyebrow">
      <LogoMark size={18} ariaLabel="Social Home logo" />
      <span>{copy.eyebrow}</span>
    </p>

    <h1 class="hero__headline">
      The <em>social</em> home<br />
      for your <em>household</em>.
    </h1>

    <p class="hero__sub">{copy.sub}</p>

    <p class="hero__ctas">
      <a class="btn btn--hearth" href={copy.installHref}>
        {copy.primaryCta}
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path
            d="M3 7 H11 M7 3 L11 7 L7 11"
            stroke="currentColor"
            stroke-width="1.6"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="btn btn--ghost" href={copy.secondaryHref}>
        {copy.secondaryCta}
      </a>
    </p>

    <p class="hero__caption">Free &amp; open source · MPL 2.0 · runs on your own Home Assistant</p>
  </div>

  <div class="shell hero__lead-in" aria-hidden="true">
    <span class="hero__lead-rule"></span>
    <span class="hero__lead-text">A glance at one household's day</span>
    <span class="hero__lead-rule"></span>
  </div>

  <div class="shell hero__wall-shell">
    <aside class="hero__wall" aria-label="A glance at one household's day">
      <FamilyWall />
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 120px) clamp(40px, 6vw, 88px);
  }
  .hero::before {
    /* Subtle warm glow behind the type block. */
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 70% 60% at 25% 18%,
        color-mix(in oklab, var(--hearth) 10%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 70% 60% at 80% 75%,
        color-mix(in oklab, var(--moss) 12%, transparent) 0%,
        transparent 65%
      );
    pointer-events: none;
    z-index: 0;
  }

  /* ── Type block — top, full-width, anchored ─────────────────────── */
  .hero__type {
    position: relative;
    z-index: 1;
    max-width: 56rem;
    /* No max-width on the .shell itself — keep type left-aligned at
       wide widths instead of centring across the full container. */
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: 6px 14px 6px 8px;
    border-radius: var(--r-pill);
    background: var(--paper-deep);
    box-shadow: 0 1px 0 var(--rule-soft);
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-feature-settings: var(--display-feat);
    font-variation-settings: var(--display-axes);
    font-weight: 540;
    font-size: var(--step-5);
    line-height: 0.92;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin: 0 0 var(--s-5);
    /* Wider measure now that the type runs full-width — break only
       at the explicit ``<br>`` we set in markup. */
    max-width: 22ch;
  }
  .hero__headline em {
    color: var(--hearth);
    font-style: italic;
    font-variation-settings: var(--display-italic-axes);
  }

  .hero__sub {
    font: 380 var(--step-1) / 1.45 var(--font-body);
    color: var(--ink-soft);
    max-width: 48ch;
    margin: 0 0 var(--s-6);
  }

  .hero__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin: 0 0 var(--s-5);
  }

  .hero__caption {
    margin: 0;
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }

  /* ── Lead-in band between type and wall ─────────────────────────── */
  .hero__lead-in {
    position: relative;
    z-index: 1;
    margin-block: clamp(48px, 7vw, 96px) var(--s-5);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-4);
  }
  .hero__lead-rule {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--rule-soft), var(--rule-soft));
  }
  .hero__lead-rule:last-child {
    background: linear-gradient(90deg, var(--rule-soft), var(--rule-soft), transparent);
  }
  .hero__lead-text {
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    white-space: nowrap;
  }

  /* ── Wall block — beneath the type, full content width ──────────── */
  .hero__wall-shell {
    position: relative;
    z-index: 1;
  }
  .hero__wall {
    /* The FamilyWall component renders its own paper background +
       internal padding; this wrapper just gives Astro a consistent
       block target for any future scroll-trigger work. */
    margin: 0;
  }
</style>
