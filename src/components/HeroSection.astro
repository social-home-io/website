---
import LogoMark from "./LogoMark.astro";
import FamilyWall from "./FamilyWall.astro";
import type { HeroCopy } from "../types";

interface Props {
  copy: HeroCopy;
}
const { copy } = Astro.props;
---

<section class="hero band band--tight">
  <div class="shell hero__grid">
    <div class="hero__col hero__col--type">
      <p class="hero__eyebrow">
        <LogoMark size={18} ariaLabel="Social Home logo" />
        <span>{copy.eyebrow}</span>
      </p>

      <h1 class="hero__headline">
        The <em>social</em> home<br />
        for your <em>household</em>.
      </h1>

      <p class="hero__sub">{copy.sub}</p>

      <p class="hero__ctas">
        <a class="btn btn--hearth" href={copy.installHref}>
          {copy.primaryCta}
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path
              d="M3 7 H11 M7 3 L11 7 L7 11"
              stroke="currentColor"
              stroke-width="1.6"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn--ghost" href={copy.secondaryHref}>
          {copy.secondaryCta}
        </a>
      </p>

      <p class="hero__caption">
        Free &amp; open source · MPL 2.0 · runs on your own Home Assistant
      </p>
    </div>

    <aside class="hero__col hero__col--wall" aria-label="A glance at one household's day">
      <FamilyWall />
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    /* Subtle warm glow behind the type column. */
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 60% 75% at 18% 35%,
        color-mix(in oklab, var(--hearth) 10%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 70% 70% at 82% 80%,
        color-mix(in oklab, var(--moss) 12%, transparent) 0%,
        transparent 65%
      );
    pointer-events: none;
    z-index: 0;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-block: clamp(56px, 9vw, 120px);
  }
  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }

  .hero__col--type {
    max-width: 30rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: 6px 14px 6px 8px;
    border-radius: var(--r-pill);
    background: var(--paper-deep);
    box-shadow: 0 1px 0 var(--rule-soft);
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-feature-settings: var(--display-feat);
    font-variation-settings: var(--display-axes);
    font-weight: 540;
    font-size: var(--step-5);
    line-height: 0.92;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin: 0 0 var(--s-5);
    max-width: 14ch;
  }
  .hero__headline em {
    color: var(--hearth);
    font-style: italic;
    font-variation-settings: var(--display-italic-axes);
  }

  .hero__sub {
    font: 380 var(--step-1) / 1.45 var(--font-body);
    color: var(--ink-soft);
    max-width: var(--measure-narrow);
    margin: 0 0 var(--s-6);
  }

  .hero__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin: 0 0 var(--s-5);
  }

  .hero__caption {
    margin: 0;
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }
</style>
