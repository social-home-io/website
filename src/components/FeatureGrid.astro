---
import type { FeatureColumn } from "../types";

interface Props {
  household: FeatureColumn;
  social: FeatureColumn;
}
const { household, social } = Astro.props;

const sides = [
  { tone: "household" as const, col: household },
  { tone: "social" as const, col: social },
];
---

<section class="grid band">
  <div class="shell">
    <div class="grid__cols">
      {
        sides.map(({ tone, col }) => (
          <div class={`grid__col grid__col--${tone}`}>
            <header class="grid__head">
              <span class={`grid__pill grid__pill--${tone}`}>
                {tone === "household" ? "Run your household" : "Stay social — privately"}
              </span>
              <h2>{col.heading}</h2>
              <p class="grid__lede">{col.lede}</p>
            </header>
            <ul class="grid__cards">
              {col.cards.map((card) => (
                <li class={`fc fc--${tone}`}>
                  <span class="fc__tag">{card.tag}</span>
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 80px);
  }
  @media (max-width: 880px) {
    .grid__cols {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }

  .grid__head {
    margin: 0 0 var(--s-5);
  }
  .grid__pill {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--s-3);
  }
  .grid__pill--household {
    background: var(--hearth-tint);
    color: var(--hearth-deep);
  }
  .grid__pill--social {
    background: var(--moss-tint);
    color: var(--moss);
  }
  .grid__head h2 {
    margin: 0 0 var(--s-3);
    max-width: 16ch;
  }
  .grid__lede {
    margin: 0;
    color: var(--ink-soft);
    font: 380 var(--step-1) / 1.45 var(--font-body);
    max-width: var(--measure-narrow);
  }

  .grid__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .fc {
    position: relative;
    padding: var(--s-5);
    background: var(--paper-deep);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-2);
    transition:
      transform var(--dur-quick) var(--ease-quill),
      border-color var(--dur-quick) var(--ease-quill);
  }
  .fc::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    border-radius: var(--r-2) 0 0 var(--r-2);
    background: currentColor;
    opacity: 0.5;
  }
  .fc:hover {
    transform: translateY(-2px);
    border-color: var(--rule);
  }
  .fc--household {
    color: var(--hearth);
  }
  .fc--social {
    color: var(--moss);
  }
  .fc__tag {
    display: inline-block;
    font: 500 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: currentColor;
    margin-bottom: var(--s-3);
  }
  .fc h3 {
    margin: 0 0 var(--s-2);
    color: var(--ink);
    font-size: var(--step-1);
  }
  .fc p {
    margin: 0;
    color: var(--ink-soft);
    font: 500 var(--step-0) / 1.55 var(--font-body);
  }
</style>
