---
/**
 * AppsFeature — the headline "Apps" band.
 *
 * Social Home Apps are installable mini-apps (chess, a shared whiteboard,
 * whatever the catalog grows) that don't just run locally — they federate
 * app-to-app with the same app in a paired household. Encryption-first,
 * peer-to-peer, the relay never involved.
 */
interface AppCard {
  glyph: string;
  name: string;
  blurb: string;
  state: "open" | "install";
}

const apps: AppCard[] = [
  {
    glyph: "♞",
    name: "Chess",
    blurb: "Play the grandparents' house, one move at a time.",
    state: "open",
  },
  { glyph: "✎", name: "Whiteboard", blurb: "Sketch a seating plan together, live.", state: "open" },
  { glyph: "◑", name: "Trivia night", blurb: "Two households, one quiz.", state: "install" },
];

const points = [
  {
    k: "App-to-app federation",
    v: "The same app in a paired home swaps moves and ops directly — no shared cloud, no lobby server.",
  },
  {
    k: "Encryption-first",
    v: "Every payload is AES-256-GCM sealed and Ed25519-signed. Only routing headers ride in the clear.",
  },
  {
    k: "Sandboxed",
    v: "Each app runs in its own locked-down frame. The admin installs once, sets an age gate, done.",
  },
  {
    k: "Peer-to-peer",
    v: "Sessions run straight between confirmed households. The relay stays out of it entirely.",
  },
];
---

<section class="apps band">
  <div class="shell apps__inner">
    <div class="apps__copy">
      <span class="eyebrow">
        <span class="dot dot--hearth" aria-hidden="true"></span>
        New · Social Home Apps
      </span>
      <h2>Apps that play across households.</h2>
      <p class="apps__lede">
        Install a small app once — a chess board, a shared whiteboard, a quiz — and it talks to the
        <em>same app</em> running in a household you've paired with. Make a move here; it lands there.
        Every byte end-to-end encrypted, straight between your two homes.
      </p>
      <dl class="apps__points">
        {
          points.map((p) => (
            <div class="apps__point">
              <dt>{p.k}</dt>
              <dd>{p.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <aside class="apps__showcase" aria-label="The Apps screen">
      <div class="catalog">
        <header class="catalog__bar">
          <span class="catalog__tab catalog__tab--on">Installed</span>
          <span class="catalog__tab">Catalog</span>
          <span class="catalog__sync" aria-hidden="true">⇄ paired with maple-st</span>
        </header>
        <ul class="catalog__list">
          {
            apps.map((a) => (
              <li class="appcard">
                <span class="appcard__glyph" aria-hidden="true">
                  {a.glyph}
                </span>
                <span class="appcard__meta">
                  <span class="appcard__name">{a.name}</span>
                  <span class="appcard__blurb">{a.blurb}</span>
                </span>
                <span class={`appcard__btn appcard__btn--${a.state}`}>
                  {a.state === "open" ? "Open" : "Install"}
                </span>
              </li>
            ))
          }
        </ul>
        <footer class="catalog__live">
          <span class="catalog__pulse" aria-hidden="true"></span>
          Chess · session open with <strong>maple-st</strong> · encrypted
        </footer>
      </div>
    </aside>
  </div>
</section>

<style>
  .apps {
    background: var(--paper-deep);
    border-block: 1px solid var(--rule-soft);
  }
  .apps__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  @media (max-width: 980px) {
    .apps__inner {
      grid-template-columns: 1fr;
    }
  }

  .apps__copy h2 {
    margin: var(--s-3) 0 var(--s-4);
    max-width: 14ch;
  }
  .apps__lede {
    color: var(--ink-soft);
    max-width: var(--measure-narrow);
    font: 380 var(--step-1) / 1.45 var(--font-body);
  }
  .apps__lede em {
    font-style: normal;
    color: var(--hearth-deep);
  }

  .apps__points {
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5) var(--s-6);
  }
  @media (max-width: 520px) {
    .apps__points {
      grid-template-columns: 1fr;
    }
  }
  .apps__point dt {
    font: 600 var(--step-0) / 1.2 var(--font-mono);
    letter-spacing: 0.01em;
    color: var(--ink);
    margin-bottom: var(--s-2);
  }
  .apps__point dd {
    margin: 0;
    color: var(--ink-soft);
    font: 500 var(--step-0) / 1.5 var(--font-body);
  }

  .dot--hearth {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--hearth);
    box-shadow: 0 0 0 4px var(--hearth-tint);
  }

  /* ─── Showcase: a faithful little "Apps" screen ─────────────────────── */
  .catalog {
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-3);
    overflow: hidden;
    box-shadow: var(--lift-pinned);
  }
  .catalog__bar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--rule-soft);
    background: var(--paper-tinted);
  }
  .catalog__tab {
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    padding-bottom: 2px;
  }
  .catalog__tab--on {
    color: var(--hearth-deep);
    border-bottom: 2px solid var(--hearth);
  }
  .catalog__sync {
    margin-left: auto;
    font: 500 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    color: var(--moss);
  }

  .catalog__list {
    list-style: none;
    margin: 0;
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .appcard {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-2);
    background: var(--paper-deep);
    border: 1px solid transparent;
    transition: border-color var(--dur-quick) var(--ease-quill);
  }
  .appcard:hover {
    border-color: var(--rule-soft);
  }
  .appcard__glyph {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--r-2);
    background: var(--hearth-tint);
    color: var(--hearth-deep);
    font-size: var(--step-2);
    line-height: 1;
  }
  .appcard__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .appcard__name {
    font: 600 var(--step-0) / 1.2 var(--font-body);
    color: var(--ink);
  }
  .appcard__blurb {
    font: 500 calc(var(--step--1) + 0.5px) / 1.3 var(--font-body);
    color: var(--ink-quiet);
  }
  .appcard__btn {
    margin-left: auto;
    flex: none;
    padding: 5px 14px;
    border-radius: var(--r-pill);
    font: 600 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .appcard__btn--open {
    background: var(--hearth);
    color: var(--paper);
  }
  .appcard__btn--install {
    background: transparent;
    color: var(--ink-soft);
    box-shadow: inset 0 0 0 1px var(--rule-soft);
  }

  .catalog__live {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-top: 1px solid var(--rule-soft);
    background: var(--moss-tint);
    color: var(--moss);
    font: 500 calc(var(--step--1) + 0.5px) / 1 var(--font-mono);
  }
  .catalog__live strong {
    color: var(--moss);
  }
  .catalog__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 0 0 var(--tape-moss);
    animation: appsPulse 2.4s var(--ease-quill) infinite;
  }
  @keyframes appsPulse {
    0% {
      box-shadow: 0 0 0 0 var(--tape-moss);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .catalog__pulse {
      animation: none;
    }
  }
</style>
