---
import LogoMark from "./LogoMark.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";

interface Props {
  /** Path of the current page — used to highlight the active nav link. */
  active?: string;
}
const { active } = Astro.props;

const links: { href: string; label: string }[] = [
  { href: "/docs/", label: "Docs" },
  { href: "/docs/protocol/", label: "How it works" },
  { href: "/docs/global-spaces/", label: "Global spaces" },
  { href: "/servers/", label: "Our server" },
  { href: "/contribute/", label: "Contribute" },
];
---

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="/" aria-label="Social Home — home">
      <LogoMark size={28} />
      <span class="wordmark__set">
        <span class="wordmark__name">Social <em>Home</em></span>
        <span class="wordmark__motto">household OS · federated · open</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={active === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="masthead__aside">
      <LocaleSwitcher />
      <a
        class="masthead__github"
        href="https://github.com/social-home-io"
        aria-label="Social Home on GitHub"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.16c-3.2.7-3.88-1.36-3.88-1.36-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.74 2.67 1.24 3.32.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.93 10.93 0 0 1 5.74 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.74.8 1.18 1.82 1.18 3.07 0 4.4-2.7 5.36-5.27 5.65.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
            fill="currentColor"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--rule-soft);
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-3);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
  }
  .wordmark__set {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .wordmark__name {
    font: 600 var(--step-1) / 1 var(--font-display);
    letter-spacing: -0.012em;
  }
  .wordmark__name em {
    color: var(--hearth);
  }
  .wordmark__motto {
    margin-top: 4px;
    font: 500 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    color: var(--ink-quiet);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav {
    margin-left: auto;
    margin-right: var(--s-4);
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-5);
  }
  .nav a {
    text-decoration: none;
    font: 500 var(--step-0) / 1 var(--font-body);
    color: var(--ink-soft);
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--hearth);
  }

  .masthead__aside {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
  }
  .masthead__github {
    color: var(--ink-soft);
    line-height: 0;
    padding: 6px;
    border-radius: var(--r-pill);
    text-decoration: none;
  }
  .masthead__github:hover {
    color: var(--ink);
    background: var(--paper-deep);
  }

  @media (max-width: 880px) {
    .nav {
      display: none;
    }
    .wordmark__motto {
      display: none;
    }
  }
</style>
