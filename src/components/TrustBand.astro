---
/**
 * TrustBand — "Private by construction".
 *
 * Six guarantees from the protocol, written for two readers at once:
 * the claim and the sentence are household language; the technical
 * terms live in a small row of mono chips under each card so a
 * technical reader still finds them. Every fact here is backed by
 * ``docs/principles.md`` and the security test suite in the
 * ``social-home-io/socialhome`` repo — if the code changes, this
 * copy changes with it.
 *
 * Trust colour is ``--moss`` (see CLAUDE.md); ``--hearth`` stays
 * reserved for primary CTAs, so this band uses the ghost button.
 */
interface Guarantee {
  /** Plain claim, ≤ 6 words. */
  claim: string;
  /** One or two sentences in household terms. */
  detail: string;
  /** Technical terms for the chip row — never in the sentence. */
  chips: string[];
}

const guarantees: Guarantee[] = [
  {
    claim: "It won't send unencrypted, ever.",
    detail:
      "If a space can't be sealed, the message stays home. There is no plain-text fallback to fall back to.",
    chips: ["AES-256-GCM", "Ed25519", "fail-closed"],
  },
  {
    claim: "Leave a space, lose the key.",
    detail:
      "Every time membership changes, the space gets a fresh key. Old members can't read new posts.",
    chips: ["per-epoch key", "rotated on every change"],
  },
  {
    claim: "The relay carries parcels, not letters.",
    detail:
      "It sees which space a sealed envelope belongs to and when — never what's inside. Strict mode hides even who sent it.",
    chips: ["padded 1/4/16/64/128 KiB", "±300 s", "24 h replay cache"],
  },
  {
    claim: "Tested before every release.",
    detail: "68 protocol test files check these rules; one failure blocks the release.",
    chips: ["tests/protocol", "release-blocking"],
  },
  {
    claim: "Nothing to sell.",
    detail: "No accounts, no analytics, no ads. The code is open for anyone to read.",
    chips: ["MPL 2.0", "no third-party JS"],
  },
  {
    claim: "Honest about the rest.",
    detail:
      "Whatever this page can't promise is written down next to the rules, with a date and a sign-off.",
    chips: ["principles.md", "signed-off residuals"],
  },
];

const principlesUrl = "https://github.com/social-home-io/socialhome/blob/main/docs/principles.md";
---

<section class="trust band">
  <div class="shell">
    <header class="trust__head">
      <span class="eyebrow">
        <span class="dot dot--moss" aria-hidden="true"></span>
        Private by construction
      </span>
      <h2>Sealed from your home to theirs. Fail-closed. Tested before every release.</h2>
      <p class="trust__lede">
        The shopping list and the book-club chat are sealed the same way: before anything leaves
        your home, it's locked so that only the households it's meant for can open it. The household
        OS and the social network share one rule, and the rule has no off switch.
      </p>
    </header>

    <ol class="trust__list">
      {
        guarantees.map((g, i) => (
          <li class="tc">
            <span class="tc__index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3>{g.claim}</h3>
            <p>{g.detail}</p>
            <ul class="tc__chips" aria-label="Technical terms">
              {g.chips.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <p class="trust__ctas">
      <a class="btn btn--ghost" href="/docs/security/">Read the security model</a>
      <a class="trust__link" href={principlesUrl}>principles.md on GitHub →</a>
    </p>
  </div>
</section>

<style>
  .trust {
    background: var(--moss-tint);
    border-block: 1px solid var(--rule-soft);
  }

  .trust__head {
    margin: 0 0 var(--s-6);
  }
  .trust__head h2 {
    margin: var(--s-3) 0 var(--s-4);
    max-width: 22ch;
    text-wrap: balance;
  }
  .trust__lede {
    margin: 0;
    color: var(--ink-soft);
    max-width: var(--measure-prose);
    font: 380 var(--step-1) / 1.45 var(--font-body);
  }

  .dot--moss {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 0 4px var(--paper);
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }
  @media (max-width: 980px) {
    .trust__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .trust__list {
      grid-template-columns: 1fr;
    }
  }

  /* Card recipe mirrors ``.fc--social`` in FeatureGrid: paper on tint,
     a 3 px moss edge, a quiet lift on hover. */
  .tc {
    position: relative;
    margin: 0;
    padding: var(--s-5);
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-2);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    transition:
      transform var(--dur-quick) var(--ease-quill),
      border-color var(--dur-quick) var(--ease-quill);
  }
  .tc::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    border-radius: var(--r-2) 0 0 var(--r-2);
    background: var(--moss);
  }
  .tc:hover {
    transform: translateY(-2px);
    border-color: var(--rule);
  }
  @media (prefers-reduced-motion: reduce) {
    .tc {
      transition: none;
    }
    .tc:hover {
      transform: none;
    }
  }

  .tc__index {
    font: 500 calc(var(--step--1) - 1px) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--moss);
  }
  .tc h3 {
    margin: 0;
    color: var(--ink);
    font-size: var(--step-1);
    letter-spacing: -0.008em;
  }
  .tc p {
    margin: 0;
    color: var(--ink-soft);
    font: 500 var(--step-0) / 1.55 var(--font-body);
  }

  .tc__chips {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .tc__chips li {
    margin: 0;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: var(--moss-tint);
    color: var(--moss);
    font: 500 calc(var(--step--1) - 1px) / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .trust__ctas {
    margin: var(--s-6) 0 0;
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .trust__link {
    font: 600 var(--step-0) / 1 var(--font-mono);
    color: var(--moss);
    text-decoration: none;
    transition: color var(--dur-quick) var(--ease-quill);
  }
  .trust__link:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
